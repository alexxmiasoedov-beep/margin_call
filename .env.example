# Токен бота от @BotFather. НИКОГДА не коммитьте настоящий .env
TG_BOT_TOKEN=123456:ABC...
# Правило сигнала
MIN_RUN_H=4        # минимум часов непрерывного присутствия монеты в канале
GAP_MIN=30         # допустимый перерыв в присутствии, минут
PUMP_MIN=8         # рост за 4ч, нижняя граница, %
PUMP_MAX=17        # рост за 4ч, верхняя граница, %
COOLDOWN_H=24      # не повторять сигнал по монете чаще, чем раз в N часов
POLL_SEC=300       # период опроса в режиме --loop, секунд
STATE_FILE=state.json
