# Токен бота от @BotFather. НИКОГДА не коммитьте настоящий .env
TG_BOT_TOKEN=123456:ABC...
# Правило сигнала
MIN_RUN_H=4        # минимум часов непрерывного присутствия монеты в канале
GAP_MIN=30         # допустимый перерыв в присутствии, минут
PUMP_MIN=8         # рост за 4ч, нижняя граница, %
PUMP_MAX=17        # рост за 4ч, верхняя граница, %
COOLDOWN_H=24      # не повторять сигнал по монете чаще, чем раз в N часов
POLL_SEC=300       # период опроса в режиме --loop, секунд
STATE_FILE=state.json
# Исполнитель сделок на BingX (bot/trader.py). Ключ — только Perpetual Futures Trade, без вывода.
BINGX_API_KEY=
BINGX_API_SECRET=
TRADE_MODE=off             # off — не торговать, paper — виртуальные сделки, live — реальные ордера
POSITION_USDT=2            # маржа на сделку, USDT
LEVERAGE=10
SL_PCT=18                  # стоп-лосс, % движения цены выше входа
TP_PCT=8                   # тейк-профит, % движения цены ниже входа
HOLD_H=24                  # выход по времени, часов
MAX_POSITIONS=3
DAILY_LOSS_LIMIT_USDT=10   # при таком убытке за день торговля ставится на паузу (/resume)
